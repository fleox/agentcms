{
  "name": "@agent-cms/agentcms",
  "version": "0.2.0",
  "type": "module",
  "description": "Static CMS whose admin runs in the browser and publishes plain HTML to any static host (GitHub/GitLab/Cloudflare Pages, S3-compatible buckets). Installable and manageable from AI coding agents.",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/fleox/agentcms#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fleox/agentcms.git"
  },
  "bugs": {
    "url": "https://github.com/fleox/agentcms/issues"
  },
  "keywords": [
    "cms",
    "static-site",
    "github-pages",
    "s3",
    "firebase",
    "sqlite",
    "markdown",
    "ai-agent",
    "claude-code"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "agentcms": "dist/agent/agentcms.mjs"
  },
  "files": [
    "dist/agent",
    "dist/admin",
    "dist/theme-assets",
    "dist/version.json",
    "plugin",
    "types",
    "changelog.json",
    "LICENSE",
    "README.md"
  ],
  "agentcms": {
    "minSkillsVersion": "0.2.0",
    "dataSchema": 2
  },
  "scripts": {
    "themes:tailwind": "node scripts/build-theme-tailwind.mjs",
    "predev": "npm run themes:tailwind",
    "dev": "vite",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.agent.json",
    "pretest": "npm run themes:tailwind",
    "test": "vitest run",
    "test:watch": "vitest",
    "prebuild": "npm run typecheck && npm run themes:tailwind",
    "build": "vite build && node scripts/build-themes.mjs && node scripts/build-bundled-externals.mjs && node scripts/pack-bundled-zips.mjs && node scripts/write-admin-manifest.mjs && vite build --config vite.agent.config.ts && node scripts/write-version.mjs",
    "pack:zips": "node scripts/pack-bundled-zips.mjs",
    "preview": "vite preview",
    "check:skills": "node scripts/check-skills.mjs",
    "version": "node scripts/sync-version.mjs && npm run build && git add -A plugin dist",
    "smoke:scaffold": "node scripts/smoke-scaffold.mjs"
  },
  "devDependencies": {
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@tiptap/extension-image": "^2.27.2",
    "@tiptap/extension-link": "^2.27.2",
    "@tiptap/extension-placeholder": "^2.27.2",
    "@tiptap/react": "^2.27.2",
    "@tiptap/starter-kit": "^2.27.2",
    "@tiptap/suggestion": "^2.27.2",
    "@types/dompurify": "^3.2.0",
    "@types/jszip": "^3.4.1",
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/sql.js": "^1.4.11",
    "@types/turndown": "^5.0.6",
    "@uiw/react-codemirror": "^4.25.9",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "dompurify": "^3.2.3",
    "firebase": "^11.0.2",
    "happy-dom": "^20.14.5",
    "i18next": "^23.16.8",
    "i18next-browser-languagedetector": "^8.0.2",
    "jsdom": "^25.0.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.460.0",
    "marked": "^15.0.5",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.2.0",
    "react-router-dom": "^6.28.0",
    "sass": "^1.83.1",
    "sql.js": "^1.13.0",
    "tailwindcss": "^3.4.14",
    "tiptap-markdown": "^0.8.10",
    "turndown": "^7.2.4",
    "typescript": "^6.0.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.8"
  }
}
